<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="klizer" translate="label" sortOrder="400">
            <label>Klizer</label>
        </tab>
        <section id="aicommerceassistant" translate="label" sortOrder="140"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Commerce Assistant</label>
            <tab>klizer</tab>
            <resource>Klizer_AiCommerceAssistant::config</resource>
            <group id="general" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable AI Commerce Assistant</label>
                    <comment>When Yes, Magento's default catalog search results page is replaced with the AI search experience (questions + Magento product recommendations).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_base_url" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>AI API Base URL</label>
                    <comment>Node assistant API (no trailing slash). Example: http://127.0.0.1:3001</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <validate>required-entry</validate>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>HTTP Timeout (seconds)</label>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="redirect_catalog_search" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Redirect to External Assistant UI (legacy)</label>
                    <comment>OFF = replace Magento catalog search with the on-site AI page (recommended). ON = redirect to External Assistant URL (e.g. localhost:5173).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="assistant_url" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>External Assistant URL (legacy)</label>
                    <comment>Only used when Redirect is ON. Example: http://localhost:5173/ai-assistant</comment>
                    <depends>
                        <field id="redirect_catalog_search">1</field>
                    </depends>
                </field>
                <field id="customer_id_hmac_secret" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Customer ID HMAC Secret</label>
                    <comment>Must match Node CUSTOMER_ID_HMAC_SECRET exactly. Signs logged-in customer_id for context memory. Leave empty only for local unsigned-customer testing.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="customer_id_token_ttl" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Customer Identity Token TTL (seconds)</label>
                    <comment>Lifetime of HMAC proof (cid_exp). Default 3600.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="analytics" translate="label" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Search Analytics (Admin ROI)</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Analytics Menu</label>
                    <comment>Shows Admin menu: AI Commerce Assistant → Search ROI Dashboard. Requires Enable AI Commerce Assistant = Yes. Uses the same AI API Base URL above.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="general/enabled">1</field>
                    </depends>
                </field>
                <field id="dashboard_url" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Full Analytics Dashboard URL</label>
                    <comment>Optional iframe / open link on the admin dashboard. Example: http://localhost:5173/analytics</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="window_days" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Default Window (days)</label>
                    <comment>Summary window for zero-result, hybrid share, and CTR.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
