<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Klizer_ImageRecognition::css/image-search.css"/>
    </head>
    <body>
        <attribute name="class" value="page-products imagerecognition-result-page"/>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Visual Search Results</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Klizer\ImageRecognition\Block\Result\ProductList"
                   name="imagerecognition.result.list"
                   template="Klizer_ImageRecognition::result/list.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
