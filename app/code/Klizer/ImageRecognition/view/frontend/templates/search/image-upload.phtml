declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Klizer\ImageRecognition\ViewModel\SearchConfig $viewModel */
$viewModel = $block->getData('view_model');

if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}
?>
<div class="image-recognition-search"
     data-mage-init='{
        "Klizer_ImageRecognition/js/image-search": {
            "uploadUrl": "<?= $escaper->escapeUrl($viewModel->getUploadUrl()) ?>",
            "maxFileSize": <?= (int) $viewModel->getMaxFileSizeBytes() ?>,
            "allowedExtensions": <?= /* @noEscape */ json_encode($viewModel->getAllowedExtensions()) ?>,
            "searchInputSelector": "#search",
            "messages": {
                "invalidType": "<?= $escaper->escapeJs(__('Please upload a valid image file.')) ?>",
                "tooLarge": "<?= $escaper->escapeJs(__('Image is too large. Maximum size is %1 MB.', number_format($viewModel->getMaxFileSizeBytes() / 1024 / 1024, 1))) ?>",
                "uploading": "<?= $escaper->escapeJs(__('Finding similar products...')) ?>",
                "genericError": "<?= $escaper->escapeJs(__('Unable to process the image. Please try again.')) ?>"
            }
        }
     }'>
    <label class="image-recognition-search__trigger"
           for="image-recognition-upload"
           title="<?= $escaper->escapeHtmlAttr(__('Search by image')) ?>">
        <span class="image-recognition-search__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="M4 8.5h2.2l1.1-2h5.4l1.1 2H16a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z"/>
                <circle cx="10" cy="13.5" r="3.2"/>
            </svg>
        </span>
        <span class="image-recognition-search__label"><?= $escaper->escapeHtml(__('Search by image')) ?></span>
    </label>
    <input type="file"
           id="image-recognition-upload"
           class="image-recognition-search__input"
           name="image"
           accept="<?= $escaper->escapeHtmlAttr($viewModel->getAcceptAttribute()) ?>"
           aria-label="<?= $escaper->escapeHtmlAttr(__('Upload image to search')) ?>"/>
    <span class="image-recognition-search__status" data-role="status" aria-live="polite"></span>
</div>
